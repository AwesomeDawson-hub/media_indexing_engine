# .env.example — Media Indexing Engine
#
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # edit .env with real secrets
#   docker compose up -d

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection URL for the backend.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://media:changeme@postgres:5432/media_indexing

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace-with-a-strong-random-secret

# ─── AI Analysis ───────────────────────────────────────────────────────────────
# Anthropic API key for Claude vision model.
ANTHROPIC_API_KEY=sk-ant-replace-with-your-api-key

# ─── File Storage ──────────────────────────────────────────────────────────────
# "local" stores files in ./uploads/ (mounted as a Docker volume).
# "s3" stores files in the configured S3 bucket.
STORAGE_PROVIDER=local

# S3 settings — required only when STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1

# ─── PostgreSQL (docker-compose postgres service) ─────────────────────────────
POSTGRES_USER=media
POSTGRES_PASSWORD=changeme
POSTGRES_DB=media_indexing
